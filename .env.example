# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# RevTap Configuration Placeholders
# ------------------------------------------------------------------
VITE_SITE_NAME="RevTap"

# PayPal REST Orders API & Webhooks
# Set PAYPAL_MODE to "live" for production (default) or "sandbox" for testing
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_MODE="live"

# Google Sheets Order Database (Service Account)
# Columns: Order ID, Date, Status, Package, Quantity, Customer, Business, Email, Phone, Website, Review URL, Logo, Shipping, Total, PayPal Txn, Supplier Info
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Transactional Email System (Resend)
RESEND_API_KEY=""
# FROM_EMAIL must be a verified domain on Resend (e.g. orders@yourdomain.com) or "onboarding@resend.dev" for testing
FROM_EMAIL="onboarding@resend.dev"
ADMIN_EMAIL="admin@revtap.com"
SUPPORT_EMAIL="support@revtap.com"

